# Prefer Google sign-in in production. Only listed, verified accounts can enter.
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=

# Exact browser origin(s) allowed to call a separately hosted API.
# Never use *. Add more exact origins as a comma-separated ALLOWED_ORIGINS list.
FRONTEND_URL=https://beaneryeatery.com
ALLOWED_ORIGINS=https://beaneryeatery.com
# The current frontend and backend use different sites (beaneryeatery.com and
# vercel.app), so cross-site fetch cookies require SameSite=None; Secure.
CROSS_SITE_COOKIES=true

# Optional public API override, for a preview or custom domain.
# Leave empty for local development; Vite proxies /api to localhost:3001.
VITE_API_URL=

# Production persistence (optional for local development).
DATABASE_URL=

# Durable image storage (optional).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Event enquiry notifications
EVENT_NOTIFICATION_EMAIL=Beaneryeatery@gmail.com
RESEND_API_KEY=
EVENT_NOTIFICATION_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:Beaneryeatery@gmail.com
