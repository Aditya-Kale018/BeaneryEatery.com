# Prefer Google sign-in in production. Only listed, verified accounts can enter.
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=

# Exact browser origin(s) allowed to call a separately hosted API.
# Never use *. Add more exact origins as a comma-separated ALLOWED_ORIGINS list.
FRONTEND_URL=https://www.example.com
ALLOWED_ORIGINS=
# Leave false when the site and API share a domain. Set true only when they are
# on different sites and FRONTEND_URL is an exact trusted origin.
CROSS_SITE_COOKIES=false

# Production persistence (optional for local development).
DATABASE_URL=

# Durable image storage (optional).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
